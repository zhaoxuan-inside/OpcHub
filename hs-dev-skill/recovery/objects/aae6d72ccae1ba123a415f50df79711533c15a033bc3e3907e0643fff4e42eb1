# ==============================================================================
# OpcHub: Production Docker Compose Multi-Container Orchestration
# Platform Stack Serving One-Person Companies (ADR-001, ADR-002, ADR-003)
# ==============================================================================
version: "3.8"

services:
  # ----------------------------------------------------------------------------
  # PostgreSQL 16 + pgvector Relational & Vector Storage (ADR-002 & ADR-003)
  # ----------------------------------------------------------------------------
  postgres:
    image: pgvector/pgvector:pg16
    container_name: opchub-postgres
    restart: unless-stopped
    ports:
      - "${POSTGRES_PORT:-5432}:5432"
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-opchub}
      POSTGRES_USER: ${POSTGRES_USER:-opc}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-opchub_secret}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-opc} -d ${POSTGRES_DB:-opchub}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 5s
    networks:
      - opchub-net

  # ----------------------------------------------------------------------------
  # Core Platform Server (FastAPI + Web Console + Unified Gateway + Microkernel)
  # ----------------------------------------------------------------------------
  opchub-server:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: opchub-core
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "${OPCHUB_PORT:-8000}:8000"
    environment:
      - OPCHUB_SERVER_HOST=0.0.0.0
      - OPCHUB_SERVER_PORT=8000
      - DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER:-opc}:${POSTGRES_PASSWORD:-opchub_secret}@postgres:5432/${POSTGRES_DB:-opchub}
      - SILICONFLOW_API_KEY=${SILICONFLOW_API_KEY:-}
      - WECHAT_PAY_V3_KEY=${WECHAT_PAY_V3_KEY:-}
      - STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY:-}
      - OPCHUB_ADMIN_EMAIL=${OPCHUB_ADMIN_EMAIL:-admin@opchub.cn}
      - OPCHUB_ADMIN_INITIAL_PASSWORD=${OPCHUB_ADMIN_INITIAL_PASSWORD:-OpcHub@Admin#2026}
      - OPCHUB_ADMIN_NICKNAME=${OPCHUB_ADMIN_NICKNAME:-平台超级管理员}
      - OPCHUB_AUDIT_RETENTION_DAYS=${OPCHUB_AUDIT_RETENTION_DAYS:-180}
      - OPCHUB_AUDIT_SECRET=${OPCHUB_AUDIT_SECRET:-}
      - OPCHUB_SECRET_KEY=${OPCHUB_SECRET_KEY:-}
    volumes:
      # Persistent local storage
      - ./data:/app/data
      # Hot-reloadable route and application configuration
      - ./backend/config:/app/backend/config:ro
      # Read-only doc index cache
      - ./hs_dev_docs/_00_project_foundation/_05_doc_index:/app/hs_dev_docs/_00_project_foundation/_05_doc_index:ro
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')\" || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 5s
    networks:
      - opchub-net

networks:
  opchub-net:
    driver: bridge

volumes:
  pgdata:
    driver: local
