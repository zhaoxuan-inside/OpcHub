# ==============================================================================
# OpcHub Platform Environment Variables Template
# Copy this file to .env and fill in your custom credentials.
# ==============================================================================

# Server Network Configuration (consumed via config.py server.host / server.port)
OPCHUB_SERVER_HOST=0.0.0.0
OPCHUB_SERVER_PORT=8000

# ------------------------------------------------------------------------------
# Docker Compose 部署配置（服务器：cp .env.example .env 后按需修改）
# ------------------------------------------------------------------------------

# 对外端口（宿主机映射；BACKEND 前端代理 /api → 后端，二者都要能被访问）
BACKEND_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL 18 + pgvector（compose 自建数据库，ADR-002 & ADR-003）
# 密码请务必修改；只能使用 URL 安全字符（字母数字 - _ . ~），
# 若需 @ : / 等特殊字符，请改配下方 OPCHUB_DATABASE_URL 整体连接串（@ → %40）
OPCHUB_PG_DB=opchub
OPCHUB_PG_USER=opc
OPCHUB_PG_PASSWORD=opchub_secret
# 整体连接串（可选，优先级高于上面三项）：
# OPCHUB_DATABASE_URL=postgresql+asyncpg://opc:opchub%40secret@postgres:5432/opchub

# SiliconFlow (硅基流动) AI Inference API Key (Optional: Leave empty for local mock)
SILICONFLOW_API_KEY=

# WeChat Pay V3 Secret Key (Optional: Leave empty for local mock)
WECHAT_PAY_V3_KEY=

# Stripe Connect Secret Key (Optional: Leave empty for local mock)
STRIPE_SECRET_KEY=

# Built-in Administrator Bootstrap (RBAC §1.1)
# The account is provisioned on startup and forced to rotate its password on first login.
OPCHUB_ADMIN_EMAIL=admin@opchub.cn
OPCHUB_ADMIN_INITIAL_PASSWORD=OpcHub@Admin#2026
OPCHUB_ADMIN_NICKNAME=平台超级管理员

# Security Audit & Cold Archive (legal_compliance §80: encrypted retention >= 180 days)
OPCHUB_AUDIT_RETENTION_DAYS=180
# Dedicated audit field-encryption secret; falls back to OPCHUB_SECRET_KEY when empty.
OPCHUB_AUDIT_SECRET=
OPCHUB_AUDIT_ARCHIVE_BATCH_SIZE=500

# Domain persistence integration tests (opt-in): point the DB integration suite at a live
# PostgreSQL instance. When unset, tests/test_db_persistence_integration.py is skipped and
# the platform runs in-memory only.
# OPCHUB_IT_DATABASE_URL=postgresql+asyncpg://opc:opchub_secret@localhost:5432/opchub

# ==============================================================================
# Multi-Vendor Outbound Email (SMTP) Configuration
# The system automatically routes emails based on the user's email domain.
# Provider-specific configurations take precedence over the global fallback.
# If no credentials are configured, the system logs codes in local development mode.
# ==============================================================================

# 1. Global Fallback SMTP Configuration (Used when no vendor-specific credentials match)
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=465
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=no-reply@yourdomain.com
# SMTP_TLS=false

# 2. Google Gmail (Targets @gmail.com, @googlemail.com)
# Host defaults to smtp.gmail.com:465
# Note: Google accounts must have 2-Step Verification enabled and use a 16-character App Password
# SMTP_GMAIL_USER=your_name@gmail.com
# SMTP_GMAIL_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_GMAIL_FROM=your_name@gmail.com

# 3. Tencent QQ Mail / Foxmail (Targets @qq.com, @vip.qq.com, @foxmail.com)
# Host defaults to smtp.qq.com:465
# Note: Enable POP3/SMTP in QQ Mail settings and obtain the dedicated authorization code
# SMTP_QQ_USER=your_qq_number@qq.com
# SMTP_QQ_PASSWORD=your_qq_authorization_code
# SMTP_QQ_FROM=your_qq_number@qq.com

# 4. NetEase 163 Mail (Targets @163.com)
# Host defaults to smtp.163.com:465
# Note: Enable POP3/SMTP in 163 settings and generate client authorization password
# SMTP_163_USER=your_account@163.com
# SMTP_163_PASSWORD=your_163_authorization_code
# SMTP_163_FROM=your_account@163.com

# 5. NetEase 126 Mail (Targets @126.com)
# SMTP_126_USER=your_account@126.com
# SMTP_126_PASSWORD=your_126_authorization_code

# 6. Microsoft Outlook / Hotmail / Office365 (Targets @outlook.com, @hotmail.com, @live.com)
# Host defaults to smtp.office365.com:587 (STARTTLS enabled)
# SMTP_OUTLOOK_USER=your_account@outlook.com
# SMTP_OUTLOOK_PASSWORD=your_outlook_app_password
# SMTP_OUTLOOK_FROM=your_account@outlook.com

# 7. Aliyun Mail (Targets @aliyun.com, @aliyun.cn)
# Host defaults to smtp.aliyun.com:465
# SMTP_ALIYUN_USER=your_account@aliyun.com
# SMTP_ALIYUN_PASSWORD=your_aliyun_client_password

# 8. Tencent Exmail 企业邮 (Targets @exmail.qq.com or enterprise custom domains)
# Host defaults to smtp.exmail.qq.com:465
# SMTP_EXMAIL_USER=admin@your-opc-company.com
# SMTP_EXMAIL_PASSWORD=your_exmail_client_password

