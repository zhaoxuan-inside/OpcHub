{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@opchub/console-ui": ["../packages/ui/src/index.ts"],
      "@opchub/console-ui/*": ["../packages/ui/src/*"],
      "@opchub/console-api": ["../packages/api/src/index.ts"]
    }
  },
  "include": ["src", "../packages/ui/src", "../packages/api/src"]
}
